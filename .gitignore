# Defensive ignore: this repo is a clean room for design notes.
# Source material (footage, weights, raw artifacts) must never be copied in.
# If any of these ever show up in `git status`, stop and delete them.

# media / footage
*.mp4
*.mov
*.avi
*.flv
*.jpg
*.jpeg
*.png

# ...except drawn diagrams. The blanket image rules above are there to keep
# footage out; they would also silently swallow a figure added to the docs, and
# a .gitignore that eats the one file a commit was for is worse than no rule.
# Anything under docs/img/ is generated by tools/draw_roi.py, not photographed.
!docs/img/*.png
!docs/img/*.svg

# model weights & exports
*.pt
*.pth
*.onnx
*.engine
*.weights

# raw measurement dumps (only the sanitized .sample.json belongs here)
*-full.json
summary.json
decision_log.json
performance_summary.json
single_video_result.json
single_video_result.csv
recognition_report.html
screenshots/

# internal spreadsheets & any tabular dumps
*.xls
*.xlsx
*.csv

# datasets & annotations
datasets/
annotations/

# environment & OS noise
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
